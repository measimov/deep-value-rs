TUSHARE_TOKEN=your_token_here
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: Uptime Kuma push URLs for cron job monitoring
# Create a Push monitor in Uptime Kuma for each mode, copy the URL:
# KUMA_PUSH_URL_DAILY=http://localhost:3001/api/push/<token-daily>
# KUMA_PUSH_URL_FINANCIAL=http://localhost:3001/api/push/<token-financial>
# KUMA_PUSH_URL_META=http://localhost:3001/api/push/<token-meta>
# Or use a single generic URL for all modes:
# KUMA_PUSH_URL=http://localhost:3001/api/push/<token>
